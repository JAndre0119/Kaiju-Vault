VITE_TMDB_API_KEY=YOUR_TMDB_API_KEY

# TMDB — used server-side by db/seed-films.js (no VITE_ prefix so it never
# ships to the browser bundle; can be the same value as VITE_TMDB_API_KEY above)
TMDB_API_KEY=YOUR_TMDB_API_KEY

# Supabase
SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Auth server
JWT_SECRET=YOUR_JWT_SECRET
PORT=3001

# Frontend — base URL of the Express API, defaults to http://localhost:3001 if unset
VITE_API_BASE_URL=http://localhost:3001
