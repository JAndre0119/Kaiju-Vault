# --- Backend (Express, deployed on Render) ---

# Supabase
SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Auth server
JWT_SECRET=YOUR_JWT_SECRET
# Render assigns this at runtime — only needed locally
PORT=3001

# TMDB — used server-side by db/seed-films.js (no VITE_ prefix so it never
# ships to the browser bundle; can be the same value as VITE_TMDB_API_KEY below)
TMDB_API_KEY=YOUR_TMDB_API_KEY

# Anthropic — used server-side by routes/recommendations.js
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# The deployed Vercel frontend URL, e.g. https://kaiju-vault.vercel.app
# Leave unset for local dev — CORS falls back to allowing any origin.
FRONTEND_URL=

# --- Frontend (Vite/React, deployed on Vercel) ---

VITE_TMDB_API_KEY=YOUR_TMDB_API_KEY

# Base URL of the deployed backend, e.g. https://kaiju-vault-api.onrender.com
# Defaults to http://localhost:3001 if unset, so local dev needs no changes.
VITE_API_URL=http://localhost:3001
